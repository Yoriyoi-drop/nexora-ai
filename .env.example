# Nexora AI Environment Configuration
# Copy this file to .env and fill in your values
# Only AI-core related infrastructure is listed here.

# Vector DB (embeddings / memory retrieval)
QDRANT_URL=http://localhost:6333

# Cache
REDIS_URL=redis://localhost:6379

# Object storage (checkpoints / datasets)
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=change_this_password
MINIO_ENDPOINT=http://localhost:9000

# Monitoring (metrics ingestion)
INFLUXDB_TOKEN=change_this_token
